{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": [
      "bun",
      "react",
      "react-dom"
    ],
    "lib": [
      "ES2024",
      "DOM",
      "DOM.Iterable"
    ],
    "paths": {
      "@oh-my-pi/pi-wire": [
        "./upstream/packages/wire/src/index.ts"
      ],
      "@oh-my-pi/pi-utils/*": [
        "./upstream/packages/utils/src/*"
      ]
    }
  },
  "include": [
    "server.ts",
    "build.ts"
  ]
}
